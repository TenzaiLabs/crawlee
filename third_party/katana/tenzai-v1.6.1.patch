+
+func (r *Runner) WriteTerminalSummary(status string) error {
+	if r.options.TerminalSummaryFile == "" {
+		return nil
+	}
+	r.terminalMu.Lock()
+	results := make([]TerminalResult, 0, len(r.terminalResults))
+	for _, result := range r.terminalResults {
+		results = append(results, result)
+	}
+	if status == "cancelled" {
+		for _, input := range mapsutil.GetKeys(r.state.InFlightUrls.GetAll()) {
+			if _, exists := r.terminalResults[input]; !exists {
+				results = append(results, TerminalResult{Input: input, Reason: "cancelled"})
+			}
+		}
+	}
+	r.terminalMu.Unlock()
+	sort.Slice(results, func(i, j int) bool { return results[i].Input < results[j].Input })
+	summary := TerminalSummary{
+		SchemaVersion: 1,
+		Status:        status,
+		GeneratedAt:   time.Now().UTC().Format(time.RFC3339Nano),
+		Inputs:        results,
+	}
+	data, err := json.MarshalIndent(summary, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(r.options.TerminalSummaryFile), 0o755); err != nil {
+		return err
+	}
+	temporaryPath := r.options.TerminalSummaryFile + ".tmp"
+	if err := os.WriteFile(temporaryPath, append(data, '\n'), 0o600); err != nil {
+		return err
+	}
+	return os.Rename(temporaryPath, r.options.TerminalSummaryFile)
+}
