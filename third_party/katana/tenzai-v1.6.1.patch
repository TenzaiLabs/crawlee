@@ -0,0 +1,31 @@
+//go:build !(386 || windows)
+
+package parser
+
+import "testing"
+
+func TestIsJsluiceJavaScriptResponse(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		path        string
+		contentType string
+		want        bool
+	}{
+		{name: "javascript extension", path: "/assets/app.js", contentType: "text/plain", want: true},
+		{name: "javascript content type", path: "/assets/bundle", contentType: "application/javascript; charset=utf-8", want: true},
+		{name: "case insensitive", path: "/assets/APP.JS", contentType: "TEXT/PLAIN", want: true},
+		{name: "stylesheet", path: "/assets/styles.css", contentType: "text/css", want: false},
+		{name: "misnamed javascript", path: "/assets/styles.css", contentType: "application/javascript", want: true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			if got := isJsluiceJavaScriptResponse(test.path, test.contentType); got != test.want {
+				t.Fatalf("isJsluiceJavaScriptResponse(%q, %q) = %t, want %t", test.path, test.contentType, got, test.want)
+			}
+		})
+	}
+}
