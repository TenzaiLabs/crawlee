--- /dev/null
+++ b/internal/runner/terminal_test.go
@@ -0,0 +1,34 @@
+package runner
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/projectdiscovery/katana/pkg/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestWriteTerminalSummary(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "terminal.json")
+	runner := &Runner{
+		options:         &types.Options{TerminalSummaryFile: path},
+		terminalResults: make(map[string]TerminalResult),
+	}
+	runner.RecordTerminalResult("https://one.example", "queue_exhausted", nil)
+	runner.RecordTerminalResult("https://two.example", "input_failure", errors.New("failed"))
+
+	require.NoError(t, runner.WriteTerminalSummary("completed"))
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	var summary TerminalSummary
+	require.NoError(t, json.Unmarshal(data, &summary))
+	require.Equal(t, 1, summary.SchemaVersion)
+	require.Equal(t, "completed", summary.Status)
+	require.Equal(t, []TerminalResult{
+		{Input: "https://one.example", Reason: "queue_exhausted"},
+		{Input: "https://two.example", Reason: "input_failure", Error: "failed"},
+	}, summary.Inputs)
+}
